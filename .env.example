# Supabase project values (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only secret; never add a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Optional admin notifications by email (Resend)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
NOTIFICATION_FROM_EMAIL=The Law Consulate <notifications@example.com>

# Optional WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
ADMIN_WHATSAPP=
# Business-initiated notifications require approved Meta templates; variable orders are in README.md.
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_ADMIN_BOOKING=
WHATSAPP_TEMPLATE_CLIENT_CONFIRMATION=
WHATSAPP_TEMPLATE_CLIENT_CANCELLATION=
WHATSAPP_TEMPLATE_CONTACT_NOTIFICATION=

# Optional extra public form protection. Obtain keys from Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
